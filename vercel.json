{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/om-foretaget", "destination": "/om-oss", "permanent": true },
    { "source": "/tillverkningen", "destination": "/tillverkning", "permanent": true },
    { "source": "/kontakta-oss", "destination": "/kontakt", "permanent": true },
    { "source": "/produkter/till-kyrka-och-forsamling", "destination": "/produkter", "permanent": true },
    { "source": "/produkter/ovriga-produkter", "destination": "/produkter", "permanent": true },
    { "source": "/produkter/tavlor", "destination": "/produkter", "permanent": true },
    { "source": "/produkter/malmklockor", "destination": "/produkter", "permanent": true },
    { "source": "/produkter/malmljusstakar", "destination": "/produkter", "permanent": false }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}

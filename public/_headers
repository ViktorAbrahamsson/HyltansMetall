# Netlify response headers.

# Keep these at launch.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite fingerprints everything in /assets (the hash is in the file name), so a
# changed file always gets a new URL and these can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PREVIEW ONLY: keeps the unfinished site out of search engines (the National
# Geographic photo is still waiting for permission). Remove at launch.
/*
  X-Robots-Tag: noindex
